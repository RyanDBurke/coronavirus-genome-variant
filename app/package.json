{
  "name": "genome-variant-aligner",
  "productName": "Genome Variant Aligner",
  "version": "0.1.0",
  "description": "Desktop app for aligning sequencing reads to the SARS-CoV-2 genome",
  "author": "Ryan Burke",
  "license": "MIT",
  "private": true,
  "_signingNotes": "Future signing: configure build.win.azureSignOptions (endpoint, codeSigningAccountName, certificateProfileName, publisherName) and AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET. Sign ../run.exe before packaging. No signing is configured now.",
  "main": "build/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "dist": "npm run build && node scripts/check-aligner.mjs && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "io.github.ryandburke.genome-variant-aligner",
    "productName": "Genome Variant Aligner",
    "copyright": "Copyright © 2026 Ryan Burke",
    "directories": { "output": "dist" },
    "files": ["build/**", "package.json"],
    "asar": true,
    "extraResources": [
      { "from": "../run.exe", "to": "aligner/run.exe" },
      { "from": "../2019-nCoV.fa", "to": "data/2019-nCoV.fa" },
      { "from": "../reads", "to": "data/reads", "filter": ["*.fa.gz"] },
      { "from": "../LICENSE", "to": "LICENSE.txt" }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "requestedExecutionLevel": "asInvoker" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "artifactName": "GenomeVariantAligner-Setup-${version}.${ext}"
    }
  }
}
