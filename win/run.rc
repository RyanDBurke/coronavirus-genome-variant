/* Windows resources for run.exe: UTF-8 manifest and version info */
#include <winver.h>

1 24 "run.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "SARS-CoV-2 read aligner (FM-Index seed search)"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "run"
            VALUE "LegalCopyright",   "Copyright (c) 2020 Ryan Burke. MIT License."
            VALUE "OriginalFilename", "run.exe"
            VALUE "ProductName",      "coronavirus-genome-variant"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
